        "body": {
          "mode": "raw",
          "raw": "{\n  \"rut\": \"{{qaStoreRut}}\",\n  \"nombreUsuario\": \"{{qaStoreUsername}}\",\n  \"nombre\": \"QA Almacenero Smoke\",\n  \"correo\": \"{{qaStoreEmail}}\",\n  \"contrasena\": \"Password123\",\n  \"tipoCuenta\": \"ALMACEN\",\n  \"nombreAlmacen\": \"{{qaStoreName}}\",\n  \"telefono\": \"+56912345678\",\n  \"direccion\": {\n    \"calle\": \"Los Queltehues\",\n    \"numero\": \"1998\",\n    \"comuna\": \"Peñalolén\",\n    \"region\": \"Metropolitana de Santiago\",\n    \"codigoPostal\": \"7940000\"\n  }\n}"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "if (pm.variables.get('runRegisterSmoke') !== 'true') { pm.execution.skipRequest(); }",
              "function rutDv(body) { let sum = 0; let m = 2; for (let i = body.length - 1; i >= 0; i -= 1) { sum += Number(body[i]) * m; m = m === 7 ? 2 : m + 1; } const r = 11 - (sum % 11); return r === 11 ? '0' : r === 10 ? 'K' : String(r); }",
              "const unique = Date.now().toString();",
              "const body = String(30000000 + (Number(unique.slice(-7)) % 5999999));",
              "pm.variables.set('qaStoreRut', `${body}-${rutDv(body)}`);",
              "pm.variables.set('qaStoreUsername', `qa_store_${unique}`);",
              "pm.variables.set('qaStoreEmail', `qa-store-${unique}@alovecino.test`);",
              "pm.variables.set('qaStoreName', `QA Store ${unique}`);"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('registro de almacen geocodificable responde exitoso', function () { pm.expect([200, 201]).to.include(pm.response.code); });",
              "pm.test('registro de almacen retorna rol almacen', function () {",
              "  const body = pm.response.json();",
              "  pm.expect(body).to.have.property('nombreRol', 'ALMACEN');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Registro de almacen queda pendiente cuando smoke esta habilitado",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",

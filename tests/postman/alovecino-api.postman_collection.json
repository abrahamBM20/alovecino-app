        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/usuarios",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"rut\": \"{{qaBadGeoRut}}\",\n  \"nombreUsuario\": \"{{qaBadGeoUsername}}\",\n  \"nombre\": \"QA Bad Geo Store\",\n  \"correo\": \"{{qaBadGeoEmail}}\",\n  \"contrasena\": \"Password123\",\n  \"tipoCuenta\": \"ALMACEN\",\n  \"nombreAlmacen\": \"QA Bad Geo Store\",\n  \"telefono\": \"+56912345678\",\n  \"direccion\": {\n    \"calle\": \"Direccion Inexistente ZZYYXX\",\n    \"numero\": \"999999\",\n    \"comuna\": \"Peñalolén\",\n    \"region\": \"Metropolitana de Santiago\",\n    \"codigoPostal\": null\n  }\n}"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "if (pm.variables.get('runRegisterSmoke') !== 'true') { pm.execution.skipRequest(); }",
              "function rutDv(body) { let sum = 0; let m = 2; for (let i = body.length - 1; i >= 0; i -= 1) { sum += Number(body[i]) * m; m = m === 7 ? 2 : m + 1; } const r = 11 - (sum % 11); return r === 11 ? '0' : r === 10 ? 'K' : String(r); }",
              "const unique = Date.now().toString();",
              "const body = String(20000000 + (Number(unique.slice(-7)) % 6999999));",
              "pm.variables.set('qaBadGeoRut', `${body}-${rutDv(body)}`);",
              "pm.variables.set('qaBadGeoUsername', `qa_bad_geo_${unique}`);",
              "pm.variables.set('qaBadGeoEmail', `qa-bad-geo-${unique}@alovecino.test`);"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('direccion no geocodificable no se registra silenciosamente', function () { pm.expect([400, 422, 502]).to.include(pm.response.code); });",
              "pm.test('error de geocodificacion es legible', function () {",
              "  const text = pm.response.text();",
              "  pm.expect(text).to.not.equal('');",
              "  try { pm.expect(pm.response.json()).to.have.property('message'); } catch (e) { pm.expect(text).to.match(/geocod|direccion|direcci/i); }",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },

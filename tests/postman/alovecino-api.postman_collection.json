    {
      "name": "Users registration creates QA client when enabled",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"rut\": \"{{qaRegisterRut}}\",\n  \"nombreUsuario\": \"{{qaRegisterUsername}}\",\n  \"nombre\": \"QA Cliente Smoke\",\n  \"correo\": \"{{qaRegisterEmail}}\",\n  \"contrasena\": \"Password123\",\n  \"tipoCuenta\": \"CLIENTE\",\n  \"fechaNacimiento\": \"1992-10-12\",\n  \"direccion\": {\n    \"calle\": \"Los Alerces\",\n    \"numero\": \"123\",\n    \"comuna\": \"Santiago\",\n    \"region\": \"Metropolitana\",\n    \"codigoPostal\": null\n  }\n}"
        },
        "url": "{{baseUrl}}/api/usuarios"
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "if (pm.variables.get('runRegisterSmoke') !== 'true') {",
              "  pm.execution.skipRequest();",
              "}",
              "function rutDv(body) {",
              "  let sum = 0;",
              "  let multiplier = 2;",
              "  for (let i = body.length - 1; i >= 0; i -= 1) {",
              "    sum += Number(body[i]) * multiplier;",
              "    multiplier = multiplier === 7 ? 2 : multiplier + 1;",
              "  }",
              "  const remainder = 11 - (sum % 11);",
              "  return remainder === 11 ? '0' : remainder === 10 ? 'K' : String(remainder);",
              "}",
              "const unique = Date.now().toString();",
              "const body = String(10000000 + (Number(unique.slice(-7)) % 8999999));",
              "pm.variables.set('qaRegisterRut', `${body}-${rutDv(body)}`);",
              "pm.variables.set('qaRegisterUsername', `qa_cliente_${unique}`);",
              "pm.variables.set('qaRegisterEmail', `qa-cliente-${unique}@alovecino.test`);"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('QA client registration succeeds', function () {",
              "  pm.expect([200, 201]).to.include(pm.response.code);",
              "});",
              "pm.test('registered client response contains identity data', function () {",
              "  const body = pm.response.json();",
              "  pm.expect(body).to.have.property('correo', pm.variables.get('qaRegisterEmail'));",
              "  pm.expect(body).to.have.property('nombreUsuario', pm.variables.get('qaRegisterUsername'));",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },

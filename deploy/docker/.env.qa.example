# NeonDB JDBC URL example:
# jdbc:postgresql://<host>/<db>?sslmode=require&channelBinding=require
NEON_DATABASE_URL=jdbc:postgresql://ep-xxxxxx-pooler.c-5.us-east-1.aws.neon.tech/neondb?sslmode=require&channelBinding=require
NEON_DATABASE_USERNAME=neondb_owner
NEON_DATABASE_PASSWORD=replace_with_real_password

GATEWAY_SERVICE_PORT=8080
AUTH_SERVICE_PORT=8082
USUARIOS_SERVICE_PORT=8081
GEO_SERVICE_PORT=8083

AUTH_JWT_ISSUER=alovecino-auth
AUTH_JWT_AUDIENCE=alovecino-api
GATEWAY_CORS_ALLOWED_ORIGINS=https://api-qa.example.com

# Required/recommended in QA for stable JWT validation across restarts.
APP_JWT_PRIVATE_KEY=
APP_JWT_PUBLIC_KEY=

# Required for real Google Maps geocoding in QA.
GOOGLE_MAPS_API_KEY=

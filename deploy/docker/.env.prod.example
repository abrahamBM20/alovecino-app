PROD_GATEWAY_PORT=80
PROD_CORS_ALLOWED_ORIGINS=https://app.example.com
PROD_NEON_DATABASE_URL=jdbc:postgresql://example.neon.tech/neondb?sslmode=require
PROD_NEON_DATABASE_USERNAME=neondb_owner
PROD_NEON_DATABASE_PASSWORD=change-me
PROD_APP_JWT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nchange-me\n-----END PRIVATE KEY-----
PROD_APP_JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\nchange-me\n-----END PUBLIC KEY-----
PROD_APP_JWT_REFRESH_COOKIE_SECURE=true
PROD_APP_JWT_REFRESH_COOKIE_SAME_SITE=None
AUTH_JWT_ISSUER=alovecino-auth
AUTH_JWT_AUDIENCE=alovecino-api
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=60

# NeonDB JDBC URL example:
# jdbc:postgresql://<host>/<db>?sslmode=require&channelBinding=require
NEON_DATABASE_URL=jdbc:postgresql://ep-billowing-math-amfel3fm-pooler.c-5.us-east-1.aws.neon.tech/neondb?sslmode=require&channelBinding=require
NEON_DATABASE_USERNAME=neondb_owner
NEON_DATABASE_PASSWORD=password

GATEWAY_SERVICE_PORT=8082
AUTH_SERVICE_PORT=8081
USUARIOS_SERVICE_PORT=8080
GEOLOCATION_SERVICE_PORT=8084

AUTH_JWT_ISSUER=alovecino-auth
AUTH_JWT_AUDIENCE=alovecino-api
GATEWAY_CORS_ALLOWED_ORIGINS=http://localhost:19006,http://localhost:3000

# Google Maps API Key para Geocoding
GOOGLE_MAPS_API_KEY=apiGoogle

# Optional for stable RS256 tokens. If omitted, auth-service generates ephemeral dev keys.
# Use PKCS8 private key and X509 public key, replacing newlines with \n when needed.
APP_JWT_PRIVATE_KEY=
APP_JWT_PUBLIC_KEY=

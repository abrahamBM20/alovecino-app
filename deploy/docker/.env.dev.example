# NeonDB JDBC URL example:
# jdbc:postgresql://<host>/<db>?sslmode=require&channelBinding=require
NEON_DATABASE_URL=jdbc:postgresql://ep-xxxxxx-pooler.c-5.us-east-1.aws.neon.tech/neondb?sslmode=require&channelBinding=require
NEON_DATABASE_USERNAME=neondb_owner
NEON_DATABASE_PASSWORD=replace_with_real_password
AUTH_SERVICE_PORT=8081
USUARIOS_SERVICE_PORT=8080

# Optional for stable RS256 tokens. If omitted, auth-service generates ephemeral dev keys.
# Use PKCS8 private key and X509 public key, replacing newlines with \n when needed.
APP_JWT_PRIVATE_KEY=
APP_JWT_PUBLIC_KEY=

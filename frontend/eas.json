{
  "cli": {
    "version": ">= 18.8.1"
  },
  "build": {
    "dev": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_VARIANT": "dev",
        "EXPO_PUBLIC_APP_ENV": "dev",
        "EXPO_PUBLIC_API_URL": "https://api-dev.example.com"
      }
    },
    "qa": {
      "distribution": "internal",
      "channel": "qa",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_VARIANT": "qa",
        "EXPO_PUBLIC_APP_ENV": "qa",
        "EXPO_PUBLIC_API_URL": "https://api-qa.example.com"
      }
    },
    "prod": {
      "channel": "production",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "APP_VARIANT": "prod",
        "EXPO_PUBLIC_APP_ENV": "prod",
        "EXPO_PUBLIC_API_URL": "https://api.example.com"
      }
    }
  },
  "submit": {
    "prod": {}
  }
}
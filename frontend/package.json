{
  "name": "app",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "start:dev-client": "expo start --dev-client",
    "android": "expo start --android",
    "android:dev-client": "expo start --android --dev-client",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "test:coverage": "jest --coverage --runInBand",
    "test:watch": "jest --watch",
    "eas:whoami": "npx eas-cli whoami",
    "eas:build:dev": "npx eas-cli build --platform android --profile dev",
    "eas:build:dev-preview": "npx eas-cli build --platform android --profile dev-preview",
    "eas:build:qa": "npx eas-cli build --platform android --profile qa",
    "eas:build:prod-preview": "npx eas-cli build --platform android --profile prod-preview",
    "eas:build:prod": "npx eas-cli build --platform android --profile prod",
    "eas:update:dev": "npx eas-cli update --branch development",
    "eas:update:qa": "npx eas-cli update --branch qa",
    "eas:update:prod": "npx eas-cli update --branch production"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "axios": "^1.15.2",
    "expo": "~54.0.34",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.21",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-location": "~19.0.8",
    "expo-router": "~6.0.23",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "~29.0.17",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.73.1",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-maps": "1.20.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "private": true,
  "devDependencies": {
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.17",
    "react-native-svg-transformer": "^1.5.3"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "@testing-library/jest-native/extend-expect"
    ]
  }
}
